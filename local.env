# ==============================================================================
# AGENTIC WEB WORKSTATION - LOCAL ENVIRONMENT CONFIGURATION (local.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Local Debug Settings
# ------------------------------------------------------------------------------
APP_ENV=local
APP_DEBUG=true
LOG_LEVEL=DEBUG

# ------------------------------------------------------------------------------
# 2. Local Browser CDP & PowerToys FancyZones
# ------------------------------------------------------------------------------
CHROME_REMOTE_DEBUGGING_PORT=9222
CHROME_USER_DATA_DIR=
FANCYZONES_ENABLED=true
FANCYZONES_LAYOUT=auto
FANCYZONES_SPACING=16
FANCYZONES_TASKBAR_MARGIN=true

# ------------------------------------------------------------------------------
# 3. Google Gemini & Vertex AI (Primary Orchestrator)
# https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# ------------------------------------------------------------------------------
# 4. Live Voice & Audio Synthesis
# ------------------------------------------------------------------------------
LIVE_MODEL=gemini-2.5-flash-native-audio-latest
LIVE_VOICE=Aoede  # Options: Aoede, Puck, Charon, Kore, Fenrir

# ------------------------------------------------------------------------------
# 5. Third-Party AI Providers & LLM Keys (Optional Overrides)
# ------------------------------------------------------------------------------
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Hugging Face: https://huggingface.co/settings/tokens
HF_TOKEN=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# DeepSeek: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Perplexity: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# xAI Grok: https://console.x.ai/
GROK_API_KEY=

# Local Ollama Endpoint
OLLAMA_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 6. OAuth 2.0 Web Browser Authentication (Optional)
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
HUGGINGFACE_CLIENT_ID=
HUGGINGFACE_CLIENT_SECRET=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
