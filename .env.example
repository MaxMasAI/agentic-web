# =================================================================
# AGENTIC WEB - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your respective API keys.
# =================================================================

# ==========================================
# 1. Google Gemini & Vertex AI (Primary LLM)
# Get API key from: https://aistudio.google.com/app/apikey
# ==========================================
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=False
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
GOOGLE_CLOUD_LOCATION=us-central1

# ==========================================
# 2. Live Voice & Audio Configuration
# ==========================================
LIVE_MODEL=gemini-2.5-flash-native-audio-latest
LIVE_VOICE=Aoede  # Options: Aoede, Puck, Charon, Kore, Fenrir

# ==========================================
# 3. Third-Party LLM Providers (Optional)
# ==========================================
# OpenRouter (100+ Models): https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Hugging Face: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# DeepSeek: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Perplexity: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# xAI Grok: https://console.x.ai/
GROK_API_KEY=your_grok_api_key_here

# Local Ollama Server
OLLAMA_URL=http://localhost:11434

# ==========================================
# 4. OAuth 2.0 Client Credentials (Optional)
# ==========================================
# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Hugging Face OAuth
HUGGINGFACE_CLIENT_ID=
HUGGINGFACE_CLIENT_SECRET=

# Auth0 / GitHub OAuth
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
