<?xml version="1.0" encoding="UTF-8"?>
<PlatformConfiguration>
    <!-- Linux Platform Specification for Agentic Web Workstation -->
    <Platform name="Linux" id="linux" version="Kernel 5.15+ (Ubuntu/Debian/Arch/Fedora)">
        <Architecture target="x86_64_aarch64">
            <DefaultShell>/bin/bash</DefaultShell>
            <FallbackShell>/bin/sh</FallbackShell>
            <PathSeparator>/</PathSeparator>
        </Architecture>

        <!-- Application Metadata & FreeDesktop Entry -->
        <Application>
            <Name>Agentic Web Workstation</Name>
            <Organization>MaxMasAI (https://github.com/MaxMasAI)</Organization>
            <Owner>Sahil Kumar Dhala (https://github.com/Sahilkumardhala)</Owner>
            <License>MIT</License>
            <DesktopEntryName>agentic-workstation.desktop</DesktopEntryName>
            <Executable>python3 app.py</Executable>
            <LauncherScript>./run.sh</LauncherScript>
            <InstallerScript>./install.sh</InstallerScript>
            <ProcessIdentifier>agentic_web_linux.pid</ProcessIdentifier>
        </Application>

        <!-- Display and UI Rendering -->
        <Display>
            <Backend>X11 / Wayland (EGL / OpenGL)</Backend>
            <HighDpiScaling>True</HighDpiScaling>
            <DpiFactor>1.0</DpiFactor>
            <WindowDecorations>GTK / XCB Dark Theme</WindowDecorations>
            <DefaultTheme>CyberpunkDark</DefaultTheme>
        </Display>

        <!-- System Shortcuts (Linux Keybindings) -->
        <Shortcuts>
            <Shortcut id="toggle_sidebar" key="Ctrl+B">Toggle Sidebar Auto-Hide / Pin</Shortcut>
            <Shortcut id="new_chat" key="Ctrl+N">New Multi-Turn Context</Shortcut>
            <Shortcut id="command_palette" key="Ctrl+K">Open Command Hub</Shortcut>
            <Shortcut id="clear_canvas" key="Ctrl+Delete">Clear Active Canvas</Shortcut>
            <Shortcut id="fullscreen" key="F11">Toggle Fullscreen</Shortcut>
            <Shortcut id="quit_app" key="Ctrl+Q">Quit Workspace</Shortcut>
        </Shortcuts>

        <!-- Hardware & System Audio/Vision Capture -->
        <HardwareCapabilities>
            <AudioEngine>PulseAudio / PipeWire / ALSA</AudioEngine>
            <ScreenCaptureEngine>X11 XGetImage / Wayland PipeWire Portal / MSS</ScreenCaptureEngine>
            <MouseKeyboardEngine>PyAutoGUI (X11 / XTest / evdev)</MouseKeyboardEngine>
            <BrowserEngine>Playwright Chromium</BrowserEngine>
        </HardwareCapabilities>

        <!-- Storage Paths and Directories -->
        <Paths>
            <AppDataRoot>~/.config/AgenticWeb</AppDataRoot>
            <LocalDatabase>db.sqlite</LocalDatabase>
            <TasksDirectory>tasks/</TasksDirectory>
            <LogsDirectory>logs/</LogsDirectory>
            <ChatsDirectory>logs/chats/</ChatsDirectory>
            <DownloadsDirectory>downloads/</DownloadsDirectory>
            <ConfigDirectory>json/</ConfigDirectory>
        </Paths>

        <!-- Security & Linux Sandbox Policies -->
        <Security>
            <RequireRootForInstall>False</RequireRootForInstall>
            <MaskCredentialsInPrompts>True</MaskCredentialsInPrompts>
            <AllowSysExec>True</AllowSysExec>
            <AutoAppendCwd>True</AutoAppendCwd>
        </Security>
    </Platform>
</PlatformConfiguration>
